# ── Servidor ──────────────────────────────────────────────
PORT=4000

# ── Base de datos (PostgreSQL local) ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<your_password>
DB_NAME=google_keep_clone

# ── Auth (JWT) ────────────────────────────────────────────

JWT_SECRET=<put anything that u want>
JWT_EXPIRES_IN=7d

# ── Frontend (CORS) ───────────────────────────────────────
CLIENT_URL=http://localhost:3000

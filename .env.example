# ── Servidor ──────────────────────────────────────────────
PORT=4000

# ── Base de datos (PostgreSQL local) ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=google_keep_clone

# ── Auth (JWT) ────────────────────────────────────────────
# ¡Nunca commitees el secreto real! Este archivo es solo el ejemplo.
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=7d

# ── Frontend (CORS) ───────────────────────────────────────
CLIENT_URL=http://localhost:3000